# --- Kallsyms & 调试基础 ---
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO=y

# --- APatch 核心依赖：Kprobes 与跟踪 ---
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBES=y
CONFIG_HAVE_KRETPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HAVE_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y

# --- 模块及内核完整性选项（必须关闭签名以防拦截） ---
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_ALL=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# --- 关闭 LTO（防止编译期链接时优化破坏 Hook 符号） ---
CONFIG_LTO=n
CONFIG_LTO_CLANG=n
CONFIG_FULL_LTO=n
# --- NoMount 核心内核驱动必需项 ---
CONFIG_NOMOUNT=y

# --- Netfilter / 钩子底层强依赖（NoMount 模块加载失败的主要原因） ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y

# --- Kprobes & 动态跟踪（APatch 及 KPM 核心依赖） ---
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_HAVE_KRETPROBES=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_HAVE_DYNAMIC_FTRACE=y

# --- 模块完整性与强制加载 ---
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_ALL=n

# --- 关闭 LTO 防止符号被优化内联导致 KPM 找不到 Hook 点 ---
CONFIG_LTO=n
CONFIG_LTO_CLANG=n
CONFIG_FULL_LTO=n
